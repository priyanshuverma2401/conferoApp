{
  "name": "confero",
  "version": "0.1.4",
  "productName": "Confero",
  "description": "Real-time AI meeting/teaching assistant: live transcription, contextual talking points, and a private overlay only you see.",
  "main": "src/main/main.js",
  "private": true,
  "author": "abhishek.prasar1@gmail.com",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-audio-loopback": "^1.0.6",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.confero.app",
    "productName": "Confero",
    "copyright": "Copyright © 2026 Confero",
    "asar": true,
    "files": [
      "**/*",
      "!.env",
      "!recordings/**",
      "!server/**",
      "!models/whisper/*.bin",
      "!dist/**",
      "!.github/**"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${arch}.${ext}",
      "maintainer": "abhishek.prasar1@gmail.com"
    }
  }
}
