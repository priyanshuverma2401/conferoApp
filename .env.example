# Confero client configuration
#
# Downloaded builds route all AI through Confero's hosted backend, which holds
# the API keys — so you normally DO NOT need to set anything in here. Just sign
# in and use the app. Leave the two providers below on "backend".

# LLM & transcription provider.
#   backend (default) — use Confero's server; NO API key needed. Recommended.
#   groq | ollama | claude — advanced/BYOK: talk to a provider directly (fill the
#   matching key/URL in the "Advanced / BYOK" section below).
LLM_PROVIDER=backend
TRANSCRIPTION_PROVIDER=backend

# ── Advanced / BYOK only ──────────────────────────────────────────────────────
# Only needed if you changed a provider above away from "backend". Uncomment and
# fill the ones you use.
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_STT_MODEL=whisper-large-v3-turbo
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Audio
AUDIO_SLIDING_WINDOW_MS=8000
AUDIO_SLIDE_INTERVAL_MS=4000

# App
STEALTH_HOTKEY=CommandOrControl+Shift+H
SUGGESTION_INTERVAL_MS=18000
