# Server
PORT=8787
# Secret used to sign login tokens — set to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER — pick which one generates suggestions. Switch anytime by changing
# CHAT_PROVIDER and filling that provider's key below, then redeploy. No code
# change needed. Transcription always uses Groq Whisper (GROQ_API_KEY required).
#
# Options: groq | gemini | openrouter | cerebras | mistral | together | cohere | openai | anthropic | ollama
CHAT_PROVIDER=groq
# Automatic failover — if the primary above errors or times out mid-request, the
# app instantly retries these backups in order (skips any without a key set).
# Strongly recommended for production. Example: gemini,openrouter
CHAT_FALLBACKS=
# ─────────────────────────────────────────────────────────────────────────────

# Groq — ACTIVE. Also always used for transcription (Whisper). Free tier, fastest.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# ── Other providers — fill a key and set CHAT_PROVIDER above to switch ──
# FREE / cheap tiers:
# GEMINI_API_KEY=            # Google Gemini Flash — generous free tier (aistudio.google.com)
# GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_API_KEY=        # many models incl. free ones (openrouter.ai)
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# CEREBRAS_API_KEY=          # very fast, free tier (cloud.cerebras.ai)
# CEREBRAS_MODEL=llama3.1-8b
# MISTRAL_API_KEY=           # free tier (console.mistral.ai)
# MISTRAL_MODEL=mistral-small-latest
# TOGETHER_API_KEY=          # free + paid open models (together.ai)
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
# COHERE_API_KEY=            # free trial tier (dashboard.cohere.com)
# COHERE_MODEL=command-r
# OLLAMA_BASE_URL=http://localhost:11434   # fully local/free (dev machine only)
# OLLAMA_MODEL=llama3.1
#
# PAID / premium (best quality):
# OPENAI_API_KEY=            # GPT (platform.openai.com)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=         # Claude (console.anthropic.com)
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Public URL this server is reachable at (used for the Google OAuth redirect).
SERVER_PUBLIC_URL=http://localhost:8787

# Google OAuth (optional) — fill these to enable "Continue with Google".
# Create a free OAuth client at console.cloud.google.com → APIs & Services →
# Credentials, with redirect URI: <SERVER_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP (optional) — fill these to actually SEND password-reset emails.
# Works with any provider (Gmail app password, SendGrid, Resend, Mailgun, etc.).
# When empty, reset links are printed to the server console instead (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Confero <no-reply@confero.app>
